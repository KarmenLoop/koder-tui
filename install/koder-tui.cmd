@echo off
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; $p=Join-Path $env:TEMP ('koder-tui-install-'+[guid]::NewGuid().ToString('N')+'.ps1'); try { $ok=$false; foreach($url in @('https://karmenloop.com/install/tui-0.3.1/koder-tui.ps1','https://github.com/KarmenLoop/koder-tui/releases/download/tui-0.3.1/koder-tui.ps1')) { try { try { Invoke-WebRequest -UseBasicParsing $url -OutFile $p -TimeoutSec 120 } catch { if(!(Get-Command curl.exe -ErrorAction SilentlyContinue)){throw}; & curl.exe --http1.1 --fail --location --retry 3 --connect-timeout 20 --max-time 120 --output $p $url; if($LASTEXITCODE -ne 0){throw 'Download failed'} }; $ok=$true; break } catch { Write-Warning $_ } }; if(!$ok -or !(Test-Path -LiteralPath $p)){throw 'Download failed. Installation stopped.'}; & $p } finally { Remove-Item -LiteralPath $p -ErrorAction SilentlyContinue }"
exit /b %errorlevel%
